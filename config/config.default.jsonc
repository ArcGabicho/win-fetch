{
  // Logo: "windows11" (4 paneles sólidos en azul, color de marca fijo),
  // "windows10" (clásico 4 colores), "none" (sin logo), o la ruta a un .txt
  // de arte ASCII personalizado.
  "logo": "windows11",

  // "classic": lista plana estilo neofetch/fastfetch (user@host, guiones,
  // Label: valor). "boxed": paneles agrupados (Hardware / Session / Uptime).
  "style": "classic",

  // Colores válidos: black, red, green, yellow, blue, magenta, cyan, white,
  // gray, cyandim (cyan apagado), matrix (verde neón), matrixdim (verde neón apagado)
  "accentColor": "cyan",
  "labelColor": "cyandim",
  "titleColor": "cyan",

  "showColorBlocks": true,
  "separator": ":",

  // Orden y selección de módulos a mostrar (solo aplica con style: "classic").
  "modules": [
    "titulo",
    "separador",
    "os",
    "host",
    "kernel",
    "uptime",
    "shell",
    "terminal",
    "resolucion",
    "cpu",
    "gpu",
    "memoria",
    "disco",
    "bateria",
    "locale",
    "espacio",
    "colores"
  ]
}
